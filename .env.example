# ============================================================
# StitchPro — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to git.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
# Service role key — server-side only, bypasses RLS
# Found in: Supabase Dashboard → Settings → API → service_role
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Payoneer ─────────────────────────────────────────────────
# Apply at: https://www.payoneer.com/developers/
# PAYONEER_CLIENT_ID=your-payoneer-client-id
# PAYONEER_SECRET_KEY=your-payoneer-secret-key
# PAYONEER_PROGRAM_ID=your-program-id
# Webhook URL to register: https://yourdomain.com/api/webhooks/payoneer
# PAYONEER_WEBHOOK_SECRET=your-webhook-signing-secret
# Payoneer environment — use 'sandbox' for testing, 'production' for live
# PAYONEER_ENVIRONMENT=sandbox

# ── Resend (Email) ───────────────────────────────────────────
# Sign up at: https://resend.com
# Add and verify your sending domain first
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Your Brand Name
RESEND_REPLY_TO=support@yourdomain.com

# ── App Config ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_APP_NAME=Your App Name
NEXT_PUBLIC_APP_TAGLINE=Your Tagline

# ── Analytics ────────────────────────────────────────────────
# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Cron Security ────────────────────────────────────────────
# Must match the x-cron-secret header sent by Vercel Cron
# Generate with: openssl rand -hex 32
CRON_SECRET=YOUR_CRON_SECRET_HERE

# ── Company Info (used in emails) ────────────────────────────
COMPANY_NAME=Your Company Name
COMPANY_EMAIL=support@yourdomain.com
COMPANY_WEBSITE=https://yourdomain.com

# ── Cloudinary (Image Uploads) ───────────────────────────────
# Get from: https://cloudinary.com/console → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ── Storage ───────────────────────────────────────────────────
# Files are stored in Supabase Storage buckets (outputs, artwork,
# free-designs). No extra config needed beyond the Supabase keys above.

# ── Legacy S3 (files uploaded before the Supabase migration) ───
# Optional. Only needed to keep downloading files uploaded before
# the migration. Remove once old files are migrated off S3.
# CHAT_ATTACHMENTS_BUCKET=YOUR_BUCKET
# S3_REGION=auto
# S3_ENDPOINT=https://YOUR_S3_ENDPOINT
# S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_KEY

# ── VAPID (Web Push) ─────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
# ── WhatsApp Cloud API (Phase 8 — inbound only) ──────────────
# Meta app → WhatsApp → Configuration. Leave unset to keep the webhook dormant:
# with no secret configured the route refuses verification and every delivery
# rather than accepting unauthenticated traffic.
# Webhook URL to register: https://yourdomain.com/api/webhooks/whatsapp
# WHATSAPP_VERIFY_TOKEN=your-random-verify-string
# WHATSAPP_APP_SECRET=your-meta-app-secret
#
# Outbound (sending replies, templates) additionally needs:
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# ── Instagram / Facebook Messaging (Phase 9 — inbound only) ──
# Same Meta app, same Graph webhook, same signature scheme as WhatsApp.
# Webhook URL to register: https://yourdomain.com/api/webhooks/meta
# META_VERIFY_TOKEN=your-random-verify-string
# META_APP_SECRET=your-meta-app-secret

# ── Follow-up engine (Phase 7) ───────────────────────────────
# OFF unless explicitly "true". The hourly cron runs either way and reports
# what it WOULD send without sending it — watch that log before arming it.
# FOLLOW_UPS_ENABLED=false
